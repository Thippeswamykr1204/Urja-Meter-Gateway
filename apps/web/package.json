{
  "name": "flock-energy-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:repeat": "for run in 1 2 3 4 5; do echo \"Vitest run $run/5\"; npm run test || exit 1; done",
    "test:watch": "vitest",
    "smoke": "playwright test",
    "generate:types": "python3 ../../tools/generate_types/main.py",
    "check:generated-types": "python3 ../../tools/generate_types/main.py --check"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.0",
    "d3-hierarchy": "^3.1.2",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.2",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^6.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.13.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.0.1",
    "vitest": "^5.0.5"
  }
}
