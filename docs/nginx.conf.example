# Render API_READ_KEY and API_ADMIN_KEY from the deployment secret store before loading this file.
# Do not serve either value as a Vite environment variable.

server {
    listen 443 ssl;
    server_name console.example.invalid;

    root /srv/flock-energy-console;
    try_files $uri /index.html;

    location /api/v1/refresh {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header X-API-Key "${API_ADMIN_KEY}";
        proxy_set_header X-Request-ID $request_id;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header X-API-Key "${API_READ_KEY}";
        proxy_set_header X-Request-ID $request_id;
    }

    location /ready {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header X-API-Key "${API_READ_KEY}";
        proxy_set_header X-Request-ID $request_id;
    }
}
